# ─────────────────────────────────────────────────────────────────────────────
# Database (Required)
# ─────────────────────────────────────────────────────────────────────────────
# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/cloud_cost_agent

# Azure Database for PostgreSQL (production) — note ?sslmode=require.
# node-postgres does NOT enable TLS unless the URL asks for it, so without this
# the password and every row would cross the network in plaintext. The app
# refuses to start against a remote host without it. Azure's certificate chains
# to a root Node already trusts, so no CA file is needed.
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require

# Connection pool ceiling. Postgres counts connections per SERVER, not per
# process, so this times the number of replicas must stay under the instance's
# max_connections (Azure Burstable B1ms allows only ~50).
# PGPOOL_MAX=10

# Used by some tooling in place of DATABASE_URL. Keep consistent with it.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=cloud_cost_agent

# ─────────────────────────────────────────────────────────────────────────────
# Secrets (Required)
# ─────────────────────────────────────────────────────────────────────────────
# Session signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# REQUIRED in production — the app refuses to start on the development
# placeholder or on anything shorter than 32 characters. Every session cookie is
# signed with this value, so a predictable key lets anyone forge a session for
# any user in any tenant without a password.
SESSION_SECRET=change-this-to-a-random-32-character-string

# Encrypts stored cloud credentials. REQUIRED — the app throws without it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Carry the SAME value with you when moving databases. Credentials in
# cloud_accounts are encrypted with this key; restore a dump under a different
# key and every stored AWS/Azure/GCP credential becomes undecryptable.
ENCRYPTION_KEY=

# Set only while rotating keys: decryption falls back to this so records
# encrypted under the old key stay readable until re-encrypted. See
# `npm run db:rotate-key`.
# ENCRYPTION_KEY_PREVIOUS=

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (Required for AI features)
# ─────────────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-api-key-here
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# Email (Optional — alerts and scheduled reports)
# ─────────────────────────────────────────────────────────────────────────────
# Option 1: Resend (https://resend.com)
# RESEND_API_KEY=re_your_resend_api_key

# Option 2: SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# Governance & Compliance (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# Periodic policy evaluation across every tenant. Set to false on a shared dev
# box or in CI, where the sweep costs database time and produces findings nobody
# reads. The UI's "Evaluate now" button works regardless.
# GOVERNANCE_ENABLED=false

# How often the scheduled sweep runs. Slower than ingestion on purpose:
# evaluating more often than the cost data behind it refreshes produces
# identical findings at real database cost.
# GOVERNANCE_INTERVAL_HOURS=6

# Refresh the cloud resource inventory before each governance sweep. This is
# what gives the encryption, public-exposure and idle-resource policies anything
# to evaluate — without it they report "not assessed" rather than "compliant".
# Uses only the read permissions inventory collection already required.
# INVENTORY_SYNC_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Web security (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# Extra origins allowed to make state-changing requests, comma separated. Needed
# ONLY when the console is served from a different origin than the API — the
# deployment shape that forces sameSite:'none' session cookies. Leave unset and
# same-origin requests still work; every cross-origin one is rejected.
#
# This is an allow-list, not a CORS convenience: each entry here is an origin
# that can drive a signed-in user's session.
# ALLOWED_ORIGINS=https://cloudwise.example.com
