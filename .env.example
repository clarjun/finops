# ─────────────────────────────────────────────────────────────────────────────
# Database (Required)
# ─────────────────────────────────────────────────────────────────────────────
# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/cloud_cost_agent

# Azure Database for PostgreSQL (production) — note ?sslmode=require.
# node-postgres does NOT enable TLS unless the URL asks for it, so without this
# the password and every row would cross the network in plaintext. The app
# refuses to start against a remote host without it. Azure's certificate chains
# to a root Node already trusts, so no CA file is needed.
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require

# Connection pool ceiling. Postgres counts connections per SERVER, not per
# process, so this times the number of replicas must stay under the instance's
# max_connections (Azure Burstable B1ms allows only ~50).
# PGPOOL_MAX=10

# Used by some tooling in place of DATABASE_URL. Keep consistent with it.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=cloud_cost_agent

# ─────────────────────────────────────────────────────────────────────────────
# Secrets (Required)
# ─────────────────────────────────────────────────────────────────────────────
# Session signing. Generate with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-random-32-character-string

# Encrypts stored cloud credentials. REQUIRED — the app throws without it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Carry the SAME value with you when moving databases. Credentials in
# cloud_accounts are encrypted with this key; restore a dump under a different
# key and every stored AWS/Azure/GCP credential becomes undecryptable.
ENCRYPTION_KEY=

# Set only while rotating keys: decryption falls back to this so records
# encrypted under the old key stay readable until re-encrypted. See
# `npm run db:rotate-key`.
# ENCRYPTION_KEY_PREVIOUS=

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (Required for AI features)
# ─────────────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-api-key-here
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# Email (Optional — alerts and scheduled reports)
# ─────────────────────────────────────────────────────────────────────────────
# Option 1: Resend (https://resend.com)
# RESEND_API_KEY=re_your_resend_api_key

# Option 2: SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# PORT=5000
