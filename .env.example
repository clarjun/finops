# Database Configuration (Required)
# For local PostgreSQL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/azure_cost_db

# PostgreSQL Connection Details
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=azure_cost_db

# Session Secret (Required) - Generate with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-random-32-character-string

# OpenAI API Configuration (Required for AI features)
# Get your API key from: https://platform.openai.com/api-keys
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-api-key-here
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Email Service Configuration (Optional - for alerts and reports)
# Choose one:

# Option 1: Resend (https://resend.com)
# RESEND_API_KEY=re_your_resend_api_key

# Option 2: SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Development Environment
NODE_ENV=development
