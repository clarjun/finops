{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InstancePowerStateOnTaggedResourcesOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:StopInstances",
        "ec2:StartInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/CloudwiseManaged": "true"
        }
      }
    },
    {
      "Sid": "RightsizingOnTaggedResourcesOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/CloudwiseManaged": "true"
        }
      }
    },
    {
      "Sid": "StorageLifecycleOnTaggedBucketsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutLifecycleConfiguration",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/CloudwiseManaged": "true"
        }
      }
    },
    {
      "Sid": "ReadNeededToActSafely",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceAttribute",
        "s3:GetBucketLocation",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverDestroyDataOrEscalate",
      "Effect": "Deny",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "rds:DeleteDBInstance",
        "rds:DeleteDBCluster",
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "iam:*",
        "sts:AssumeRole",
        "organizations:*",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    }
  ]
}
